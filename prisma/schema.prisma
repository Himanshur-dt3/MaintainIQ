generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  REPORTER
}

enum TicketStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  ELECTRICAL
  PLUMBING
  HVAC
  INTERNET_IT
  APPLIANCE
  STRUCTURAL_GENERAL
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenancePlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MaintenanceFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum MaintenanceType {
  PREVENTIVE
  INSPECTION
  SERVICING
}

model User {
  id                String          @id @default(uuid())
  name              String
  email             String          @unique
  passwordHash      String
  role              Role
  jobTitle          String?
  reportedTickets   Ticket[]        @relation("ReportedTickets")
  assignedTickets   Ticket[]        @relation("AssignedTickets")
  historyEntries    TicketHistory[] @relation("HistoryActor")
  reporterReviews   Review[]        @relation("ReporterReviews")
  technicianReviews Review[]        @relation("TechnicianReviews")
  assignedMaintenancePlans MaintenancePlan[] @relation("MaintenancePlanTechnician")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([role])
}

model Asset {
  id        String      @id @default(uuid())
  name      String      @unique
  type      String
  location  String
  status            AssetStatus        @default(ACTIVE)
  criticality       AssetCriticality  @default(MEDIUM)
  tickets           Ticket[]
  maintenancePlans  MaintenancePlan[]
  createdAt         DateTime           @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location])
}

model Ticket {
  id              String          @id @default(uuid())
  title           String
  description     String
  location        String
  issueType       IssueType
  priority        Priority        @default(MEDIUM)
  status          TicketStatus    @default(REPORTED)
  assetId         String
  reporterId      String
  technicianId    String?
  resolutionNotes String?

  // SLA tracking
  slaDeadline    DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?

  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reporter        User            @relation("ReportedTickets", fields: [reporterId], references: [id], onDelete: Restrict)
  technician      User?           @relation("AssignedTickets", fields: [technicianId], references: [id], onDelete: SetNull)
  aiAnalysis      AIAnalysis?
  history         TicketHistory[]
  review          Review?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([priority])
  @@index([issueType])
  @@index([reporterId])
  @@index([technicianId])
  @@index([assetId])
  @@index([createdAt])
}

model AIAnalysis {
  id                    String    @id @default(uuid())
  ticketId              String    @unique
  issueType             IssueType
  priority              Priority
  possibleCauses        String[]
  recommendedTechnician String
  suggestedAction       String
  confidence            Float
  ticket                Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MaintenancePlan {
  id                String               @id @default(uuid())
  assetId           String
  technicianId      String?
  title             String
  description       String?
  type              MaintenanceType      @default(PREVENTIVE)
  frequency         MaintenanceFrequency @default(ONCE)
  status            MaintenancePlanStatus @default(ACTIVE)
  priority          Priority             @default(MEDIUM)
  nextDueAt         DateTime
  lastCompletedAt   DateTime?
  notes             String?
  asset             Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician        User?                @relation("MaintenancePlanTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([assetId])
  @@index([technicianId])
  @@index([status])
  @@index([nextDueAt])
}

model TicketHistory {
  id            String   @id @default(uuid())
  ticketId      String
  actorId       String?
  action        String
  previousValue String?
  newValue      String?
  note          String?
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor         User?    @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([actorId])
}

model Review {
  id           String   @id @default(uuid())
  ticketId     String   @unique
  reporterId   String
  technicianId String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reporter   User   @relation("ReporterReviews", fields: [reporterId], references: [id], onDelete: Restrict)
  technician User   @relation("TechnicianReviews", fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([reporterId])
  @@index([technicianId])
  @@index([createdAt])
}
