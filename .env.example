# PostgreSQL connection used by Prisma. Request this value from the deployer.
DATABASE_URL=

# Auth.js session signing secret. Request a high-entropy value from the deployer.
AUTH_SECRET=

# Canonical application URL, for example http://localhost:3000 in development.
AUTH_URL=

# Anthropic configuration. Request these values from the deployer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_MS=15000

# Optional isolated PostgreSQL connection for integration tests.
TEST_DATABASE_URL=
